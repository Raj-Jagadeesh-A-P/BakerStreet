# --- Firebase ---
# Copy to .env and adjust. Local development uses the emulators and needs no
# Firebase account: keep the demo project id and FIRESTORE_EMULATOR_HOST, then
# run `npm run emulators` before `npm run dev`.
FIREBASE_PROJECT_ID="glugot-found"
# Active only while developing against local emulators. Remove for production.
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# Path to the Firebase service-account JSON used by the Admin SDK in production.
FIREBASE_SERVICE_ACCOUNT=""
# Cloud Storage bucket (uploads). Not used until storage is wired up.
FIREBASE_STORAGE_BUCKET="glugot-found.firebasestorage.app"

# --- Server ---
PORT=4000
# Temporary until auth moves onto Firebase Auth. Remove afterwards.
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated list of origins allowed to call the API when hosted separately.
CORS_ORIGIN="http://localhost:5173"
# JWT lifetime
JWT_EXPIRES_IN="12h"

# --- Admin + demo seed (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@glugot.dev"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- File uploads (final-case evidence) ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# --- Demo team seed ---
SEED_DEMO_EMAIL="demo@glugot.dev"
SEED_DEMO_PASSWORD="demo-password-123"
SEED_DEMO_PARTNER_EMAIL="partner@glugot.dev"
SEED_DEMO_PARTNER_PASSWORD="partner-password-123"