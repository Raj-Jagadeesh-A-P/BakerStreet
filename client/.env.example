# Vite config for the GLUGOT web client. Copy to client/.env and adjust.
#
# EMULATOR-FIRST DEV (default): leave VITE_FIREBASE_API_KEY empty and the app
# automatically connects to the Firebase Auth emulator on 127.0.0.1:9099
# (backend must be running against the emulators via `npm run emulators`).
#
# PRODUCTION/REAL PROJECT: fill the API key and app config from Firebase console
# Project settings -> Your apps -> Web app. Setting VITE_FIREBASE_API_KEY turns
# the emulator connection off automatically. Then run `npm run build`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=glugot-found
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099